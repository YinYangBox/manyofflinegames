    }
    *{box-sizing:border-box}
    html,body{min-height:100%}
    body{
      margin:0;color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      background:
        radial-gradient(circle at 12% 8%,rgba(67,208,207,.16),transparent 31rem),
        radial-gradient(circle at 88% 85%,rgba(255,185,83,.11),transparent 34rem),
        linear-gradient(145deg,#041018,#0b1820 52%,#07131a);
      overflow-x:hidden;-webkit-tap-highlight-color:transparent;user-select:none;
    }
    body::before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.18;background-image:linear-gradient(rgba(255,255,255,.024) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,#000,transparent 88%)}
    button,select{font:inherit}button{border:0;color:inherit;cursor:pointer}button:disabled{opacity:.48;cursor:default}
    button:focus-visible,select:focus-visible{outline:3px solid rgba(87,228,223,.58);outline-offset:3px}
    .app{width:min(100%,840px);min-height:100vh;margin:0 auto;padding:max(14px,env(safe-area-inset-top)) 14px max(22px,env(safe-area-inset-bottom));position:relative}
    .app.game-layout{width:min(100%,1160px);padding-top:max(10px,env(safe-area-inset-top))}.app.game-layout>.topbar{display:none}
    .topbar{height:58px;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
    .brand{display:flex;align-items:center;gap:10px;min-width:0}.brand-mark{width:39px;height:39px;display:grid;place-items:center;border:1px solid rgba(87,228,223,.4);border-radius:12px;background:linear-gradient(145deg,rgba(87,228,223,.18),rgba(87,228,223,.03));box-shadow:inset 0 1px rgba(255,255,255,.1),0 8px 22px rgba(0,0,0,.25)}
    .bubble-logo{position:relative;width:25px;height:25px}.bubble-logo i{position:absolute;border-radius:50%;box-shadow:inset 0 3px 4px rgba(255,255,255,.55),inset 0 -4px 5px rgba(0,0,0,.16)}.bubble-logo i:nth-child(1){width:14px;height:14px;left:1px;top:8px;background:#ff6d7f}.bubble-logo i:nth-child(2){width:12px;height:12px;right:0;top:1px;background:#5ddcff}.bubble-logo i:nth-child(3){width:10px;height:10px;right:2px;bottom:0;background:#ffd85f}
    .brand-name{font-size:18px;font-weight:950;letter-spacing:.105em;white-space:nowrap}.credit-chip{min-width:104px;height:40px;padding:0 13px;display:flex;align-items:center;justify-content:center;gap:7px;border:1px solid rgba(255,214,111,.28);border-radius:999px;background:rgba(11,20,29,.8);box-shadow:inset 0 1px rgba(255,255,255,.06);font-weight:900;font-variant-numeric:tabular-nums}.credit-icon{width:18px;height:18px;display:grid;place-items:center;border:2px solid var(--gold);border-radius:50%;color:var(--gold);font:900 10px/1 Georgia,serif}
    .screen{display:none;animation:screen-in .27s var(--ease)}.screen.active{display:block}@keyframes screen-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
    .hero{position:relative;overflow:hidden;min-height:260px;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(235px,.92fr);align-items:center;border:1px solid var(--line);border-radius:25px;background:radial-gradient(circle at 78% 24%,rgba(87,228,223,.18),transparent 31%),linear-gradient(135deg,#18313b,#0d1920 62%);box-shadow:var(--shadow),inset 0 1px rgba(255,255,255,.06)}
    .hero-copy{padding:31px 12px 31px 31px;z-index:2}.eyebrow{margin:0 0 9px;color:var(--aqua2);font-size:11px;font-weight:950;letter-spacing:.17em;text-transform:uppercase}h1,h2,h3,p{margin-top:0}h1{margin-bottom:8px;font:800 clamp(39px,8vw,64px)/.95 Georgia,"Times New Roman",serif;letter-spacing:-.045em}.hero-copy p:last-of-type{max-width:370px;margin-bottom:22px;color:#c9d8dd;font-size:14px;line-height:1.5}
    .hero-art{min-height:260px;position:relative;display:grid;place-items:center;pointer-events:none}.hero-field{position:relative;width:225px;height:220px;filter:drop-shadow(0 28px 34px rgba(0,0,0,.32));transform:rotate(-4deg)}.hero-field::before{content:"";position:absolute;inset:16px 9px 12px;border-radius:30px;background:linear-gradient(160deg,#0b5060,#0b2836);box-shadow:inset 0 0 0 2px rgba(255,255,255,.08)}.hero-b{position:absolute;width:39px;height:39px;border-radius:50%;box-shadow:inset 0 7px 7px rgba(255,255,255,.48),inset 0 -8px 10px rgba(0,0,0,.2),0 9px 15px rgba(0,0,0,.3)}.hero-b::after{content:"";position:absolute;width:9px;height:6px;left:9px;top:7px;border-radius:50%;background:rgba(255,255,255,.7);transform:rotate(-24deg)}.hero-b.r{background:#ff6178}.hero-b.y{background:#ffd85d}.hero-b.b{background:#54cfff}.hero-b.g{background:#61df9c}.hero-b.p{background:#a879ff}.hero-b.o{background:#ff9f50}.hero-cannon{position:absolute;left:93px;bottom:17px;width:39px;height:83px;border-radius:18px;background:linear-gradient(90deg,#bed5d9,#f4ffff 48%,#78969e);transform:rotate(19deg);transform-origin:50% 86%;box-shadow:0 10px 16px rgba(0,0,0,.3)}.hero-cannon::after{content:"";position:absolute;width:58px;height:58px;border-radius:50%;left:-10px;bottom:-20px;background:radial-gradient(circle at 35% 25%,#8ffff7,#29aaa7 57%,#0a5c66);box-shadow:inset 0 3px rgba(255,255,255,.35)}
    .menu-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:12px;margin-top:12px}.panel{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(24,45,56,.97),rgba(12,25,33,.97));box-shadow:inset 0 1px rgba(255,255,255,.05),0 14px 36px rgba(0,0,0,.2)}.setup-panel{padding:17px}.section-label{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 9px;color:#9eb1bb;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.section-label strong{color:var(--text);letter-spacing:0}.setup-row{margin-top:14px}.segmented{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:4px;border:1px solid rgba(255,255,255,.07);border-radius:12px;background:rgba(2,7,11,.3)}.segment{min-height:40px;padding:8px 7px;border-radius:9px;color:#9aa8b4;background:transparent;font-size:11px;font-weight:850;transition:.18s var(--ease)}.segment.active{color:#071119;background:linear-gradient(135deg,#bafffb,#54d9d4);box-shadow:0 5px 15px rgba(87,228,223,.18)}.select-wrap{position:relative}select{width:100%;height:45px;appearance:none;padding:0 40px 0 13px;border:1px solid rgba(255,255,255,.1);border-radius:11px;color:var(--text);background:#0a171d;font-weight:800;cursor:pointer}.select-wrap::after{content:"⌄";position:absolute;right:14px;top:8px;color:var(--aqua);font-size:20px;pointer-events:none}
    .primary-btn,.secondary-btn,.tile-btn{min-height:48px;border-radius:12px;font-size:13px;font-weight:950;letter-spacing:.035em;transition:transform .16s var(--ease),filter .16s,border-color .16s}.primary-btn{color:#061018;background:linear-gradient(135deg,#c8fffb,#4bd8d4);box-shadow:0 10px 25px rgba(58,190,187,.22),inset 0 1px rgba(255,255,255,.6)}.primary-btn:hover:not(:disabled){filter:brightness(1.06);transform:translateY(-1px)}.primary-btn:active:not(:disabled){transform:translateY(1px) scale(.99)}.secondary-btn{border:1px solid rgba(255,255,255,.12);color:#d7e0e7;background:rgba(255,255,255,.045)}.secondary-btn:hover:not(:disabled){border-color:rgba(87,228,223,.5);transform:translateY(-1px)}.play-btn{width:100%;margin-top:16px}
    .quick-panel{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding:12px}.quick-card{min-height:98px;padding:13px;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;border:1px solid rgba(255,255,255,.085);border-radius:13px;color:var(--text);background:rgba(255,255,255,.035);text-align:left;transition:.18s var(--ease)}.quick-card:hover{border-color:rgba(87,228,223,.42);background:rgba(87,228,223,.055);transform:translateY(-2px)}.quick-icon{width:31px;height:31px;display:grid;place-items:center;border-radius:9px;color:var(--aqua2);background:rgba(87,228,223,.1);font-size:17px;font-weight:950}.quick-card strong{font-size:12px}.quick-card small{color:#8fa2ab;font-size:10px}.mode-strip{grid-column:1/-1;min-height:76px;padding:14px;display:flex;align-items:center;gap:12px;border:1px solid rgba(87,228,223,.2);border-radius:13px;background:linear-gradient(110deg,rgba(87,228,223,.08),rgba(255,255,255,.02));text-align:left}.mode-emblem{flex:0 0 auto;width:44px;height:44px;display:grid;place-items:center;border:1px solid rgba(87,228,223,.35);border-radius:50%;color:var(--aqua2);background:#09161b;font-weight:950;font-size:16px}.mode-strip-copy{min-width:0;flex:1}.mode-strip-copy strong{display:block;font-size:13px}.mode-strip-copy small{display:block;margin-top:3px;color:#8fa2ab;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .page-head{display:flex;align-items:center;gap:12px;margin:7px 0 18px}.back-btn,.icon-btn{flex:0 0 auto;width:42px;height:42px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.1);border-radius:12px;color:#d7e1e8;background:rgba(255,255,255,.045);font-size:19px}.back-btn:hover,.icon-btn:hover{border-color:rgba(87,228,223,.42)}.page-title{min-width:0}.page-title h2{margin:0;font:800 28px/1 Georgia,serif}.page-title p{margin:4px 0 0;color:#8fa2ab;font-size:12px}
    .tabs{margin-bottom:13px;max-width:360px}.shop-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.shop-card{position:relative;overflow:hidden;min-height:180px;padding:15px;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,rgba(38,57,67,.95),rgba(20,31,39,.97));box-shadow:inset 0 1px rgba(255,255,255,.05);text-align:left;transition:.18s var(--ease)}.shop-card:hover{transform:translateY(-2px);border-color:rgba(87,228,223,.36)}.shop-card.selected{border-color:var(--aqua);box-shadow:inset 0 0 0 1px rgba(87,228,223,.2),0 10px 28px rgba(0,0,0,.22)}
    .shop-art{height:88px;margin:-15px -15px 12px;display:grid;place-items:center;border-bottom:1px solid rgba(255,255,255,.08);background:radial-gradient(circle at 25% 20%,rgba(255,255,255,.12),transparent 27%),linear-gradient(135deg,rgba(87,228,223,.15),rgba(58,78,92,.16))}.bubble-preview{width:74px;height:74px;position:relative}.bubble-preview i{position:absolute;width:36px;height:36px;border-radius:50%;box-shadow:inset 0 6px 6px rgba(255,255,255,.48),inset 0 -6px 8px rgba(0,0,0,.2),0 6px 10px rgba(0,0,0,.22)}.bubble-preview i:nth-child(1){left:4px;top:22px}.bubble-preview i:nth-child(2){right:4px;top:10px}.bubble-preview i:nth-child(3){right:12px;bottom:3px}.arena-preview{width:82px;height:70px;border-radius:11px;border:5px solid var(--ap-frame,#1f6670);background:linear-gradient(var(--ap-top,#123847),var(--ap-bottom,#071921));box-shadow:inset 0 0 0 1px rgba(255,255,255,.08),0 8px 14px rgba(0,0,0,.3);position:relative;overflow:hidden}.arena-preview::before{content:"";position:absolute;left:10px;right:10px;top:16px;height:2px;background:rgba(255,255,255,.08);box-shadow:0 12px rgba(255,255,255,.06),0 24px rgba(255,255,255,.05)}.shop-card h3{margin:0 0 5px;font-size:14px}.shop-card p{flex:1;margin:0 0 12px;color:#9caeb6;font-size:11px;line-height:1.4}.shop-foot{display:flex;align-items:center;justify-content:space-between;gap:8px}.price,.owned-tag,.selected-tag{min-height:27px;display:inline-flex;align-items:center;gap:5px;border-radius:999px;font-size:10px;font-weight:900}.price{padding:0 9px;color:var(--gold);background:rgba(255,214,111,.1)}.owned-tag{padding:0 9px;color:var(--good);background:rgba(116,225,168,.1)}.selected-tag{padding:0 9px;color:#071315;background:var(--aqua)}.shop-action{min-height:30px;padding:0 11px;border-radius:8px;color:#071315;background:linear-gradient(135deg,#c6fffb,#4ed9d4);font-size:10px;font-weight:900}
    .stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.stat-card{padding:17px}.stat-card span{display:block;color:#96a8b0;font-size:11px;text-transform:uppercase;letter-spacing:.08em}.stat-card strong{display:block;margin-top:8px;font:800 31px/1 Georgia,serif;color:var(--aqua2)}.rules-card{margin-top:12px;padding:17px}.rules-card h3{margin-bottom:10px;font-size:13px}.rules-card p{margin-bottom:7px;color:#a6b4ba;font-size:12px;line-height:1.5}
    /* game */
    #game-screen{width:100%}.game-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.game-mode-label{min-width:0;text-align:center}.game-mode-label strong{display:block;font:800 17px/1 Georgia,serif}.game-mode-label small{display:block;margin-top:4px;color:#90a4ad;font-size:10px;letter-spacing:.07em;text-transform:uppercase}
    .game-layout-grid{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:14px;align-items:start}.game-card{position:relative;padding:10px;border:1px solid rgba(255,255,255,.09);border-radius:18px;background:linear-gradient(155deg,rgba(24,45,56,.98),rgba(8,20,27,.98));box-shadow:0 24px 60px rgba(0,0,0,.4),inset 0 1px rgba(255,255,255,.05)}
    .hud{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:8px}.hud-item{min-width:0;padding:8px 7px;border:1px solid rgba(255,255,255,.07);border-radius:11px;background:rgba(255,255,255,.035);text-align:center}.hud-item span{display:block;color:#88a0a9;font-size:8px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.hud-item strong{display:block;margin-top:3px;font-size:14px;font-variant-numeric:tabular-nums}.hud-item.danger strong{color:#ff8898}.canvas-wrap{position:relative;width:min(100%,650px);margin:0 auto;aspect-ratio:640/900;border-radius:15px;overflow:hidden;background:#071921;touch-action:none}.canvas-wrap::after{content:"";position:absolute;inset:0;pointer-events:none;border:1px solid rgba(255,255,255,.08);border-radius:15px;box-shadow:inset 0 0 35px rgba(0,0,0,.25)}#game-canvas{display:block;width:100%;height:100%;touch-action:none}
    .side-panel{padding:12px;display:grid;gap:10px}.side-box{padding:13px;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:rgba(255,255,255,.035)}.side-title{margin-bottom:9px;color:#8ea3ad;font-size:9px;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.ammo-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ammo{min-height:91px;padding:8px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.07);border-radius:12px;background:rgba(2,8,11,.22)}.ammo span{display:block;margin-top:5px;color:#8ca1aa;font-size:8px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.ammo-bubble{width:47px;height:47px;border-radius:50%;box-shadow:inset 0 8px 7px rgba(255,255,255,.5),inset 0 -8px 10px rgba(0,0,0,.2),0 7px 11px rgba(0,0,0,.25);position:relative}.ammo-bubble::after{content:"";position:absolute;width:11px;height:7px;left:11px;top:8px;border-radius:50%;background:rgba(255,255,255,.75);transform:rotate(-22deg)}.side-copy{color:#9fb0b7;font-size:11px;line-height:1.45}.miss-pips{display:flex;flex-wrap:wrap;gap:5px}.miss-pip{width:15px;height:15px;border-radius:50%;border:2px solid rgba(255,255,255,.16);background:rgba(255,255,255,.03)}.miss-pip.on{border-color:#ffb55d;background:#ffb55d;box-shadow:0 0 12px rgba(255,181,93,.25)}.game-actions{display:grid;grid-template-columns:1fr;gap:8px}.tile-btn{border:1px solid rgba(255,255,255,.1);color:#cbd7dc;background:rgba(255,255,255,.04);font-size:11px}.tile-btn:hover:not(:disabled){border-color:rgba(87,228,223,.42)}.tiny-note{margin:0;color:#78909a;font-size:9px;line-height:1.4;text-align:center}
    .toast-stack{position:fixed;z-index:100;left:50%;bottom:max(22px,env(safe-area-inset-bottom));width:min(calc(100% - 28px),430px);display:flex;flex-direction:column;align-items:center;gap:8px;transform:translateX(-50%);pointer-events:none}.toast{max-width:100%;padding:10px 14px;border:1px solid rgba(255,255,255,.13);border-radius:999px;color:#eee;background:rgba(10,17,21,.94);box-shadow:0 12px 35px rgba(0,0,0,.4);font-size:12px;font-weight:800;animation:toast-in .24s var(--ease),toast-out .3s 2.3s forwards}.toast.reward{color:var(--gold);border-color:rgba(255,214,111,.43)}@keyframes toast-in{from{opacity:0;transform:translateY(8px) scale(.96)}}@keyframes toast-out{to{opacity:0;transform:translateY(6px)}}
    .modal-layer{position:fixed;z-index:80;inset:0;padding:20px;display:grid;place-items:center;background:rgba(3,7,10,.76);backdrop-filter:blur(8px);opacity:0;visibility:hidden;transition:.2s}.modal-layer.open{opacity:1;visibility:visible}.modal{width:min(100%,430px);padding:23px;border:1px solid rgba(255,255,255,.12);border-radius:21px;background:linear-gradient(145deg,#273841,#121d23);box-shadow:0 25px 80px rgba(0,0,0,.6),inset 0 1px rgba(255,255,255,.07);transform:translateY(10px) scale(.98);transition:.22s var(--ease);text-align:center}.modal-layer.open .modal{transform:none}.modal-symbol{margin-bottom:10px;color:var(--aqua2);font:800 47px/1 Georgia,serif}.modal h2{margin-bottom:7px;font:800 31px/1.05 Georgia,serif}.modal p{margin-bottom:19px;color:#a9b7bd;font-size:13px;line-height:1.45}.modal-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px}.modal-actions.one{grid-template-columns:1fr}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 18px}.result-stat{padding:10px 6px;border:1px solid rgba(255,255,255,.08);border-radius:11px;background:rgba(255,255,255,.035)}.result-stat span{display:block;color:#8ea2ab;font-size:8px;text-transform:uppercase;font-weight:900;letter-spacing:.08em}.result-stat b{display:block;margin-top:4px;font-size:16px}.result-stat.reward b{color:var(--gold)}.hidden{display:none!important}
