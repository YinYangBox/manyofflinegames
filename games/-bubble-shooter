<body>
  <main class="app" id="app">
    <header class="topbar">
      <div class="brand"><div class="brand-mark"><div class="bubble-logo"><i></i><i></i><i></i></div></div><span class="brand-name">BUBBLE SHOOTER</span></div>
      <div class="credit-chip"><span class="credit-icon">C</span><span data-credits>0</span></div>
    </header>

    <section class="screen active" id="menu-screen">
      <div class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Aim · bank · pop</p>
          <h1>Make it burst.</h1>
          <p>Read the wall bounce, build a cluster and drop everything hanging underneath it.</p>
          <button class="primary-btn" id="hero-play" style="min-width:150px;padding:0 24px">PLAY</button>
        </div>
        <div class="hero-art" aria-hidden="true"><div class="hero-field">
          <i class="hero-b r" style="left:37px;top:40px"></i><i class="hero-b b" style="left:78px;top:39px"></i><i class="hero-b y" style="left:119px;top:39px"></i><i class="hero-b p" style="left:58px;top:79px"></i><i class="hero-b g" style="left:99px;top:79px"></i><i class="hero-b o" style="left:140px;top:79px"></i><i class="hero-b r" style="left:78px;top:118px"></i><i class="hero-b b" style="left:119px;top:118px"></i><div class="hero-cannon"></div>
        </div></div>
      </div>

      <div class="menu-grid">
        <div class="panel setup-panel">
