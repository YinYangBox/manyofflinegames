<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#07131a">
  <title>Bubble Shooter</title>
  <style>
    :root{
      --bg:#061017;--panel:#10202a;--panel2:#172c39;--line:rgba(255,255,255,.1);
      --text:#f7fbff;--muted:#93a8b7;--aqua:#57e4df;--aqua2:#b8fffb;--gold:#ffd66f;
