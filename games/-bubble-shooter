<script>
"use strict";

const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const clamp = (v,a,b)=>Math.max(a,Math.min(b,v));
const lerp = (a,b,t)=>a+(b-a)*t;
const rand = n => Math.floor(Math.random()*n);

class SaveManager{
  static ROOT_KEY="ARCADE_GAMES"; static GAME_KEY="bubble-shooter";
  constructor(){
    this.defaults={version:1,credits:0,selectedMode:"classic",difficulty:"normal",sound:true,guide:true,selectedBubble:"gloss",selectedArena:"lagoon",ownedBubbles:["gloss"],ownedArenas:["lagoon"],activeRun:null,stats:{games:0,wins:0,bubblesPopped:0,bubblesDropped:0,shots:0,bestScore:0,bestCombo:1,creditsEarned:0,rushBest:0,endlessBest:0}};
    this.root=this.readRoot(); this.data=this.sanitize(this.root[SaveManager.GAME_KEY]); this.persist();
  }
  readRoot(){try{const raw=localStorage.getItem(SaveManager.ROOT_KEY);const obj=raw?JSON.parse(raw):{};return obj&&typeof obj==="object"&&!Array.isArray(obj)?obj:{}}catch{return{}}}
  sanitize(v){const s=v&&typeof v==="object"?v:{};const d={...this.defaults,...s};d.stats={...this.defaults.stats,...(s.stats||{})};for(const k of ["credits"])d[k]=Math.max(0,Math.floor(Number(d[k])||0));for(const k of Object.keys(this.defaults.stats))d.stats[k]=Math.max(k==="bestCombo"?1:0,Math.floor(Number(d.stats[k])||0));d.ownedBubbles=this.clean(d.ownedBubbles,"gloss");d.ownedArenas=this.clean(d.ownedArenas,"lagoon");d.sound=d.sound!==false;d.guide=d.guide!==false;return d}
  clean(a,required){const x=Array.isArray(a)?[...new Set(a.filter(v=>typeof v==="string"))]:[];if(!x.includes(required))x.unshift(required);return x}
  persist(){try{this.root[SaveManager.GAME_KEY]=this.data;localStorage.setItem(SaveManager.ROOT_KEY,JSON.stringify(this.root))}catch{} $$(`[data-credits]`).forEach(el=>el.textContent=this.data.credits)}
  update(p){Object.assign(this.data,p);this.persist()}
  owns(kind,id){return this.data[kind==="bubble"?"ownedBubbles":"ownedArenas"].includes(id)}
  buy(kind,id,price){if(this.owns(kind,id)||this.data.credits<price)return false;this.data.credits-=price;const key=kind==="bubble"?"ownedBubbles":"ownedArenas";this.data[key]=[...this.data[key],id];this.persist();return true}
  addCredits(n){n=Math.max(0,Math.floor(n));if(!n)return;this.data.credits+=n;this.data.stats.creditsEarned+=n;this.persist()}
}

const BUBBLE_SKINS={
  gloss:{name:"Gloss",price:0,desc:"Bright arcade bubbles with a glassy highlight.",style:"gloss"},
  candy:{name:"Candy",price:900,desc:"Soft pastels with a sugary shine.",style:"candy"},
  neon:{name:"Neon",price:1850,desc:"Electric rings that glow against the arena.",style:"neon"},
  pearl:{name:"Pearl",price:2800,desc:"Smooth pearlescent bubbles with muted depth.",style:"pearl"},
  cosmic:{name:"Cosmic",price:4200,desc:"Dark cores, star sparks and luminous rims.",style:"cosmic"}
};
const ARENAS={
  lagoon:{name:"Lagoon",price:0,desc:"Deep teal glass and cool water light.",top:"#123b49",bottom:"#06171f",frame:"#1d6c76"},
  sunset:{name:"Sunset",price:1100,desc:"Warm violet haze above a dark horizon.",top:"#553653",bottom:"#1a1628",frame:"#aa6b72"},
  midnight:{name:"Midnight",price:2200,desc:"A quiet navy arena with silver lines.",top:"#18233b",bottom:"#080d18",frame:"#516080"},
  arcade:{name:"Arcade",price:3350,desc:"Purple circuitry and cyan rails.",top:"#231344",bottom:"#09071c",frame:"#45e4e0"},
  galaxy:{name:"Galaxy",price:5000,desc:"A starfield suspended behind the bubbles.",top:"#231c4c",bottom:"#050817",frame:"#7968c4"}
};
const MODES={
  classic:{name:"Classic",icon:"3+",desc:"Clear the whole ceiling."},rush:{name:"Rush",icon:"90",desc:"Score as much as possible in 90 seconds."},endless:{name:"Endless",icon:"∞",desc:"New waves continue until the board reaches you."}
};
const DIFF={easy:{name:"Easy",colors:5,rows:5,misses:6,note:"Relaxed"},normal:{name:"Normal",colors:6,rows:6,misses:5,note:"Balanced"},hard:{name:"Hard",colors:7,rows:7,misses:4,note:"Crowded"}};
const BASE_COLORS=["#ff5f76","#55d4ff","#ffd85e","#60dfa0","#a77aff","#ff9c4a","#f06ee0"];
const CANDY_COLORS=["#ff8fa8","#82dcff","#ffe68a","#8ce5bb","#c3a1ff","#ffbc7c","#f69be7"];
const PEARL_COLORS=["#d9687b","#6faec3","#d3bd72","#72aa8c","#9586b9","#c58e63","#bc75aa"];

const save=new SaveManager();
let activeScreen="menu-screen";
function updateCredits(){$$("[data-credits]").forEach(el=>el.textContent=save?.data?.credits??0)}
function showScreen(id){$$(".screen").forEach(s=>s.classList.toggle("active",s.id===id));activeScreen=id;$("#app").classList.toggle("game-layout",id==="game-screen");window.scrollTo({top:0,behavior:"instant"})}
function openModal(el){el.classList.add("open")}function closeModal(el){el.classList.remove("open")}
function toast(msg,reward=false){const el=document.createElement("div");el.className="toast"+(reward?" reward":"");el.textContent=msg;$("#toast-stack").append(el);setTimeout(()=>el.remove(),2700)}

class AudioFX{
  constructor(){this.ctx=null}
  ensure(){if(!save.data.sound)return null;try{this.ctx??=new (window.AudioContext||window.webkitAudioContext)();if(this.ctx.state==="suspended")this.ctx.resume();return this.ctx}catch{return null}}
  tone(freq=440,dur=.08,type="sine",gain=.035,slide=0){const c=this.ensure();if(!c)return;const o=c.createOscillator(),g=c.createGain(),t=c.currentTime;o.type=type;o.frequency.setValueAtTime(freq,t);if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(40,freq+slide),t+dur);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(gain,t+.008);g.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(g).connect(c.destination);o.start(t);o.stop(t+dur+.02)}
  shoot(){this.tone(270,.09,"triangle",.035,160)} pop(n=3){this.tone(520+Math.min(9,n)*28,.08,"sine",.04,180)} drop(){this.tone(210,.15,"triangle",.025,-90)} bounce(){this.tone(360,.035,"sine",.012,45)} row(){this.tone(130,.18,"sawtooth",.018,60)} win(){[0,110,220,330].forEach((d,i)=>setTimeout(()=>this.tone(520+i*120,.13,"triangle",.04,100),d))} lose(){this.tone(240,.28,"sawtooth",.025,-130)}
}
const audio=new AudioFX();

class BubbleGame{
  constructor(canvas){
    this.canvas=canvas;this.ctx=canvas.getContext("2d");this.W=640;this.H=900;this.R=27;this.CELL=58;this.VSTEP=50;this.TOP=43;this.STARTX=32;this.SHOOTER={x:320,y:842};this.DANGER_Y=728;this.grid=[];this.current=null;this.next=null;this.shot=null;this.particles=[];this.falling=[];this.aim=-Math.PI/2;this.dragging=false;this.running=false;this.paused=false;this.ended=false;this.busyUntil=0;this.rowAnim=null;this.score=0;this.combo=1;this.bestCombo=1;this.shots=0;this.missesLeft=5;this.elapsed=0;this.rushLeft=90;this.lastTs=performance.now();this.swapUsed=false;this.startTime=0;this.raf=0;this.lastSaveAt=0;this.bind();this.loop=this.loop.bind(this);this.raf=requestAnimationFrame(this.loop);
  }
  bind(){
    const pos=e=>{const r=this.canvas.getBoundingClientRect();return{x:(e.clientX-r.left)*this.W/r.width,y:(e.clientY-r.top)*this.H/r.height}};
    this.canvas.addEventListener("pointerdown",e=>{if(!this.canAim())return;this.dragging=true;this.canvas.setPointerCapture?.(e.pointerId);const p=pos(e);this.setAim(p.x,p.y);e.preventDefault()});
    this.canvas.addEventListener("pointermove",e=>{if(!this.running||this.paused)return;const p=pos(e);if(this.dragging||e.pointerType==="mouse")this.setAim(p.x,p.y);e.preventDefault()});
    this.canvas.addEventListener("pointerup",e=>{if(!this.dragging)return;this.dragging=false;try{this.canvas.releasePointerCapture?.(e.pointerId)}catch{}const p=pos(e);this.setAim(p.x,p.y);this.fire();e.preventDefault()});
    this.canvas.addEventListener("pointercancel",()=>this.dragging=false);
    window.addEventListener("keydown",e=>{if(activeScreen!=="game-screen"||!this.running||this.paused)return;if(e.key==="ArrowLeft"){this.aim=clamp(this.aim-.055,-Math.PI+.18,-.18);e.preventDefault()}if(e.key==="ArrowRight"){this.aim=clamp(this.aim+.055,-Math.PI+.18,-.18);e.preventDefault()}if(e.code==="Space"){this.fire();e.preventDefault()}if(e.key.toLowerCase()==="s"){this.swap();e.preventDefault()}});
    document.addEventListener("visibilitychange",()=>{if(document.hidden&&this.running&&!this.paused&&!this.ended)this.pause()});
  }
  maxCols(r){return 10}
  cellPos(r,c){return{x:this.STARTX+this.R+c*this.CELL+(r%2?this.CELL/2:0),y:this.TOP+this.R+r*this.VSTEP}}
  valid(r,c){return r>=0&&c>=0&&c<this.maxCols(r)}
  get(r,c){return this.grid[r]?.[c]||null}
  set(r,c,v){while(this.grid.length<=r)this.grid.push([]);this.grid[r][c]=v}
  neighbors(r,c){const even=r%2===0;const a=[[r,c-1],[r,c+1]];if(even)a.push([r-1,c-1],[r-1,c],[r+1,c-1],[r+1,c]);else a.push([r-1,c],[r-1,c+1],[r+1,c],[r+1,c+1]);return a.filter(([rr,cc])=>this.valid(rr,cc))}
  mode(){return MODES[save.data.selectedMode]||MODES.classic} diff(){return DIFF[save.data.difficulty]||DIFF.normal}
  newGame(){
    this.grid=[];this.current=this.randomColor();this.next=this.randomColor();this.shot=null;this.particles=[];this.falling=[];this.score=0;this.combo=1;this.bestCombo=1;this.shots=0;this.missesLeft=this.diff().misses;this.elapsed=0;this.rushLeft=90;this.aim=-Math.PI/2;this.swapUsed=false;this.paused=false;this.ended=false;this.running=true;this.startTime=Date.now();this.seedRows(this.diff().rows);this.updateUI();this.persistRun(true);showScreen("game-screen");
    save.data.stats.games++;save.persist();
  }
  restore(run){
    try{this.grid=(run.grid||[]).map((row,r)=>(row||[]).map((v,c)=>v==null?null:{color:Number(v.color),placedAt:0}));this.current=Number(run.current)||0;this.next=Number(run.next)||0;this.score=Number(run.score)||0;this.combo=Math.max(1,Number(run.combo)||1);this.bestCombo=Math.max(1,Number(run.bestCombo)||1);this.shots=Number(run.shots)||0;this.missesLeft=Math.max(0,Number(run.missesLeft)||this.diff().misses);this.elapsed=Number(run.elapsed)||0;this.rushLeft=Number(run.rushLeft)||90;this.aim=-Math.PI/2;this.swapUsed=false;this.shot=null;this.particles=[];this.falling=[];this.paused=false;this.ended=false;this.running=true;this.startTime=Date.now()-this.elapsed*1000;this.updateUI();showScreen("game-screen");return true}catch{return false}
  }
  seedRows(n){for(let r=0;r<n;r++){for(let c=0;c<this.maxCols(r);c++){let color=rand(this.diff().colors);if(c>=2&&Math.random()<.38){const a=this.get(r,c-1),b=this.get(r,c-2);if(a&&b&&a.color===b.color)color=(color+1+rand(this.diff().colors-1))%this.diff().colors}this.set(r,c,{color,placedAt:performance.now()-300})}}}
  randomColor(){const present=this.presentColors();const pool=present.length?present:[...Array(this.diff().colors).keys()];return pool[rand(pool.length)]}
  presentColors(){const s=new Set;for(const row of this.grid)for(const b of row||[])if(b)s.add(b.color);return [...s]}
  canAim(){return this.running&&!this.paused&&!this.ended&&!this.shot&&performance.now()>=this.busyUntil}
  setAim(x,y){const dx=x-this.SHOOTER.x,dy=y-this.SHOOTER.y;if(dy>-25)return;let a=Math.atan2(dy,dx);if(a>-.18)a=-.18;if(a<-Math.PI+.18)a=-Math.PI+.18;this.aim=a}
  fire(){if(!this.canAim())return;this.shot={x:this.SHOOTER.x,y:this.SHOOTER.y-15,vx:Math.cos(this.aim)*720,vy:Math.sin(this.aim)*720,color:this.current};this.shots++;save.data.stats.shots++;this.current=this.next;this.next=this.randomColor();this.swapUsed=false;audio.shoot();this.updateUI();this.persistRun();}
  swap(){if(!this.canAim()||this.swapUsed)return;[this.current,this.next]=[this.next,this.current];this.swapUsed=true;audio.tone(430,.06,"triangle",.028,80);this.updateUI();this.persistRun()}
  update(dt){if(!this.running||this.paused||this.ended)return;this.elapsed+=dt;if(save.data.selectedMode==="rush"){this.rushLeft-=dt;if(this.rushLeft<=0){this.rushLeft=0;this.finish(false,true);return}}
    if(this.shot)this.updateShot(dt);this.updateParticles(dt);this.updateFalling(dt);if(performance.now()-this.lastSaveAt>2500)this.persistRun();this.updateUI(false)
  }
  updateShot(dt){const s=this.shot;const steps=Math.max(1,Math.ceil(Math.hypot(s.vx,s.vy)*dt/(this.R*.6)));const sub=dt/steps;for(let i=0;i<steps&&this.shot;i++){s.x+=s.vx*sub;s.y+=s.vy*sub;if(s.x<=this.R+7){s.x=this.R+7;s.vx=Math.abs(s.vx);audio.bounce()}else if(s.x>=this.W-this.R-7){s.x=this.W-this.R-7;s.vx=-Math.abs(s.vx);audio.bounce()}if(s.y<=this.TOP+this.R*.35){this.attachShot(s.x,this.TOP+this.R*.35);break}for(let r=0;r<this.grid.length;r++){for(let c=0;c<this.maxCols(r);c++){const b=this.get(r,c);if(!b)continue;const p=this.cellPos(r,c),dx=s.x-p.x,dy=s.y-p.y;if(dx*dx+dy*dy<=(this.R*1.88)**2){this.attachShot(s.x,s.y);return}}}}
  }
  findSnap(x,y){let best=null,bd=Infinity;const rr=clamp(Math.round((y-this.TOP-this.R)/this.VSTEP),0,17);for(let r=Math.max(0,rr-2);r<=Math.min(18,rr+2);r++){for(let c=0;c<this.maxCols(r);c++){if(this.get(r,c))continue;const p=this.cellPos(r,c),d=(x-p.x)**2+(y-p.y)**2;if(d<bd&&(r===0||this.neighbors(r,c).some(([a,b])=>this.get(a,b)))){best=[r,c];bd=d}}}if(!best){for(let r=0;r<19;r++)for(let c=0;c<this.maxCols(r);c++)if(!this.get(r,c)){const p=this.cellPos(r,c),d=(x-p.x)**2+(y-p.y)**2;if(d<bd){best=[r,c];bd=d}}}return best}
  attachShot(x,y){const s=this.shot;this.shot=null;const cell=this.findSnap(x,y);if(!cell){this.finish(false);return}const [r,c]=cell;this.set(r,c,{color:s.color,placedAt:performance.now()});const cluster=this.cluster(r,c,s.color);if(cluster.length>=3){const gain=cluster.length*35*this.combo;this.score+=gain;this.combo++;this.bestCombo=Math.max(this.bestCombo,this.combo);save.data.stats.bestCombo=Math.max(save.data.stats.bestCombo,this.bestCombo);for(const [rr,cc] of cluster)this.removeBubble(rr,cc,true);save.data.stats.bubblesPopped+=cluster.length;audio.pop(cluster.length);const dropped=this.dropLoose();if(dropped){this.score+=dropped*70*this.combo;save.data.stats.bubblesDropped+=dropped;audio.drop()}this.missesLeft=Math.min(this.diff().misses,this.missesLeft+1);const remaining=this.presentColors();if(remaining.length&&!remaining.includes(this.current))this.current=this.randomColor();this.next=this.randomColor();}
    else{this.combo=1;this.missesLeft--;if(this.missesLeft<=0){this.addRow();this.missesLeft=this.diff().misses}}
    this.compactRows();save.data.stats.bestScore=Math.max(save.data.stats.bestScore,this.score);this.checkState();this.updateUI();this.persistRun();
  }
  cluster(r,c,color){const out=[],seen=new Set,stack=[[r,c]];while(stack.length){const [rr,cc]=stack.pop(),k=rr+","+cc;if(seen.has(k)||!this.valid(rr,cc))continue;seen.add(k);const b=this.get(rr,cc);if(!b||b.color!==color)continue;out.push([rr,cc]);for(const n of this.neighbors(rr,cc))stack.push(n)}return out}
  removeBubble(r,c,pop){const b=this.get(r,c);if(!b)return;const p=this.cellPos(r,c);this.set(r,c,null);if(pop){for(let i=0;i<7;i++){const a=Math.random()*Math.PI*2,s=50+Math.random()*150;this.particles.push({x:p.x,y:p.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-30,life:.45+Math.random()*.25,max:.7,color:b.color,size:4+Math.random()*5})}}}
  dropLoose(){const attached=new Set,stack=[];for(let c=0;c<this.maxCols(0);c++)if(this.get(0,c))stack.push([0,c]);while(stack.length){const [r,c]=stack.pop(),k=r+","+c;if(attached.has(k))continue;const b=this.get(r,c);if(!b)continue;attached.add(k);for(const n of this.neighbors(r,c))if(this.get(...n))stack.push(n)}let count=0;for(let r=0;r<this.grid.length;r++)for(let c=0;c<this.maxCols(r);c++){const b=this.get(r,c);if(b&&!attached.has(r+","+c)){const p=this.cellPos(r,c);this.falling.push({x:p.x,y:p.y,vy:30+Math.random()*50,vx:(Math.random()-.5)*65,color:b.color,rot:(Math.random()-.5)*2});this.set(r,c,null);count++}}return count}
  addRow(){const old=this.grid;const row=[];for(let c=0;c<10;c++)row[c]={color:rand(this.diff().colors),placedAt:performance.now()};this.grid=[row,...old.map(r=>r?Array.from(r):[])];this.rowAnim={start:performance.now(),dur:240};this.busyUntil=performance.now()+250;audio.row();toast("Fresh row!")}
  compactRows(){while(this.grid.length&&(!this.grid[this.grid.length-1]||this.grid[this.grid.length-1].every(x=>!x)))this.grid.pop()}
  checkState(){const count=this.grid.reduce((n,row)=>n+(row||[]).filter(Boolean).length,0);if(count===0){if(save.data.selectedMode==="classic"){this.finish(true);return}else{this.score+=1000;toast("Wave cleared · +1000",true);this.grid=[];this.seedRows(Math.max(4,this.diff().rows-1));this.current=this.randomColor();this.next=this.randomColor();this.missesLeft=this.diff().misses;this.rowAnim={start:performance.now(),dur:260}}}for(let r=0;r<this.grid.length;r++)for(let c=0;c<this.maxCols(r);c++)if(this.get(r,c)&&this.cellPos(r,c).y+this.R>=this.DANGER_Y){this.finish(false);return}}
  finish(win,timeUp=false){if(this.ended)return;this.ended=true;this.running=false;save.data.activeRun=null;const mode=save.data.selectedMode;let credits=0;if(mode==="classic")credits=win?({easy:80,normal:120,hard:175}[save.data.difficulty]+Math.min(120,Math.floor(this.score/500))):Math.min(25,Math.floor(this.score/1200));else if(mode==="rush")credits=Math.min(180,Math.floor(this.score/350));else credits=Math.min(200,Math.floor(this.score/450));if(win){save.data.stats.wins++;audio.win()}else audio.lose();save.data.stats.bestScore=Math.max(save.data.stats.bestScore,this.score);if(mode==="rush")save.data.stats.rushBest=Math.max(save.data.stats.rushBest,this.score);if(mode==="endless")save.data.stats.endlessBest=Math.max(save.data.stats.endlessBest,this.score);save.addCredits(credits);save.persist();$("#result-symbol").textContent=win?"✦":timeUp?"90":"×";$("#result-title").textContent=win?"Board cleared!":timeUp?"Time!":"Bubbles reached the line";$("#result-text").textContent=win?"Every cluster is gone. Clean finish.":timeUp?"Rush complete. Your final score is locked in.":"The ceiling got too close. Try cutting support clusters earlier.";$("#result-score").textContent=this.score.toLocaleString();$("#result-combo").textContent="×"+this.bestCombo;$("#result-credits").textContent="C "+credits;openModal($("#result-modal"));updateMenu();}
  pause(){if(!this.running||this.ended)return;this.paused=true;openModal($("#pause-modal"));this.persistRun()}
  resume(){this.paused=false;this.lastTs=performance.now();closeModal($("#pause-modal"))}
  persistRun(force=false){if(!this.running||this.ended)return;this.lastSaveAt=performance.now();save.data.activeRun={grid:this.grid.map(row=>(row||[]).map(b=>b?{color:b.color}:null)),current:this.current,next:this.next,score:this.score,combo:this.combo,bestCombo:this.bestCombo,shots:this.shots,missesLeft:this.missesLeft,elapsed:this.elapsed,rushLeft:this.rushLeft,mode:save.data.selectedMode,difficulty:save.data.difficulty};save.persist()}
  updateParticles(dt){for(const p of this.particles){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=280*dt}this.particles=this.particles.filter(p=>p.life>0)}
  updateFalling(dt){for(const b of this.falling){b.vy+=540*dt;b.y+=b.vy*dt;b.x+=b.vx*dt}this.falling=this.falling.filter(b=>b.y<this.H+100)}
  palette(){const s=save.data.selectedBubble;if(s==="candy")return CANDY_COLORS;if(s==="pearl")return PEARL_COLORS;return BASE_COLORS}
  drawBubble(x,y,color,r=this.R,alpha=1){const ctx=this.ctx,pal=this.palette(),base=pal[color%pal.length]||"#fff",skin=save.data.selectedBubble;ctx.save();ctx.globalAlpha=alpha;ctx.translate(x,y);if(skin==="neon"){ctx.shadowBlur=18;ctx.shadowColor=base;ctx.strokeStyle=base;ctx.lineWidth=5;ctx.fillStyle="rgba(6,12,20,.82)";ctx.beginPath();ctx.arc(0,0,r*.9,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.shadowBlur=0;ctx.fillStyle=base;ctx.globalAlpha*=.45;ctx.beginPath();ctx.arc(-r*.25,-r*.25,r*.12,0,Math.PI*2);ctx.fill()}else if(skin==="cosmic"){const g=ctx.createRadialGradient(-r*.3,-r*.35,2,0,0,r);g.addColorStop(0,"#fff");g.addColorStop(.08,base);g.addColorStop(.48,"#1c1e3c");g.addColorStop(1,base);ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill();ctx.strokeStyle="rgba(255,255,255,.36)";ctx.lineWidth=2;ctx.stroke();for(let i=0;i<3;i++){const a=(color*1.7+i*2.1);ctx.fillStyle="rgba(255,255,255,.75)";ctx.fillRect(Math.cos(a)*r*.5,Math.sin(a)*r*.5,2,2)}}else{const g=ctx.createRadialGradient(-r*.32,-r*.38,r*.08,0,0,r);g.addColorStop(0,"#fff");g.addColorStop(.13,base);g.addColorStop(.68,base);g.addColorStop(1,"#1118");ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill();ctx.strokeStyle=skin==="pearl"?"rgba(255,255,255,.28)":"rgba(255,255,255,.18)";ctx.lineWidth=2;ctx.stroke();ctx.fillStyle="rgba(255,255,255,.62)";ctx.beginPath();ctx.ellipse(-r*.28,-r*.34,r*.18,r*.11,-.4,0,Math.PI*2);ctx.fill()}ctx.restore()}
  arena(){return ARENAS[save.data.selectedArena]||ARENAS.lagoon}
  draw(){const ctx=this.ctx,a=this.arena();ctx.clearRect(0,0,this.W,this.H);const g=ctx.createLinearGradient(0,0,0,this.H);g.addColorStop(0,a.top);g.addColorStop(1,a.bottom);ctx.fillStyle=g;ctx.fillRect(0,0,this.W,this.H);if(save.data.selectedArena==="galaxy"){ctx.fillStyle="rgba(255,255,255,.7)";for(let i=0;i<46;i++){const x=(i*137)%this.W,y=(i*83)%700;ctx.globalAlpha=.18+((i*11)%7)/14;ctx.fillRect(x,y,1.5,1.5)}ctx.globalAlpha=1}else{ctx.strokeStyle="rgba(255,255,255,.035)";ctx.lineWidth=1;for(let y=60;y<760;y+=70){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(this.W,y);ctx.stroke()}}
    ctx.strokeStyle="rgba(255,120,135,.36)";ctx.lineWidth=2;ctx.setLineDash([9,9]);ctx.beginPath();ctx.moveTo(18,this.DANGER_Y);ctx.lineTo(this.W-18,this.DANGER_Y);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle="rgba(255,145,155,.7)";ctx.font="900 11px system-ui";ctx.fillText("DANGER",18,this.DANGER_Y-8);
    let shift=0;if(this.rowAnim){const t=clamp((performance.now()-this.rowAnim.start)/this.rowAnim.dur,0,1);shift=-this.VSTEP*(1-(1-Math.pow(1-t,3)));if(t>=1)this.rowAnim=null}
    const now=performance.now();for(let r=0;r<this.grid.length;r++)for(let c=0;c<this.maxCols(r);c++){const b=this.get(r,c);if(!b)continue;const p=this.cellPos(r,c);let scale=1;if(b.placedAt&&now-b.placedAt<180){const t=(now-b.placedAt)/180;scale=t<.65?lerp(.55,1.12,t/.65):lerp(1.12,1,(t-.65)/.35)}this.drawBubble(p.x,p.y+shift,b.color,this.R*scale)}
    for(const b of this.falling)this.drawBubble(b.x,b.y,b.color,this.R);
    for(const p of this.particles){ctx.globalAlpha=clamp(p.life/p.max,0,1);ctx.fillStyle=this.palette()[p.color];ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;
    if(this.running&&!this.ended){if(save.data.guide&&!this.shot)this.drawGuide();const ang=this.shot?Math.atan2(this.shot.vy,this.shot.vx):this.aim;ctx.save();ctx.translate(this.SHOOTER.x,this.SHOOTER.y);ctx.rotate(ang+Math.PI/2);const lg=ctx.createLinearGradient(-17,0,17,0);lg.addColorStop(0,"#607d82");lg.addColorStop(.5,"#edfdfd");lg.addColorStop(1,"#607d82");ctx.fillStyle=lg;ctx.beginPath();ctx.roundRect(-15,-68,30,76,14);ctx.fill();ctx.restore();ctx.fillStyle="#0d3036";ctx.beginPath();ctx.arc(this.SHOOTER.x,this.SHOOTER.y,43,0,Math.PI*2);ctx.fill();ctx.strokeStyle=a.frame;ctx.lineWidth=5;ctx.stroke();this.drawBubble(this.SHOOTER.x,this.SHOOTER.y-2,this.current,24);if(this.shot)this.drawBubble(this.shot.x,this.shot.y,this.shot.color,this.R)}
  }
  drawGuide(){const ctx=this.ctx;let x=this.SHOOTER.x,y=this.SHOOTER.y-25,vx=Math.cos(this.aim),vy=Math.sin(this.aim);ctx.save();for(let i=0;i<58;i++){x+=vx*11;y+=vy*11;if(x<this.R+7){x=this.R+7;vx=Math.abs(vx)}else if(x>this.W-this.R-7){x=this.W-this.R-7;vx=-Math.abs(vx)}if(y<this.TOP+this.R*.3)break;let hit=false;for(let r=0;r<this.grid.length&&!hit;r++)for(let c=0;c<this.maxCols(r);c++){if(!this.get(r,c))continue;const p=this.cellPos(r,c);if((x-p.x)**2+(y-p.y)**2<(this.R*1.82)**2){hit=true;break}}if(hit)break;if(i%2===0){ctx.globalAlpha=.22+.5*(i/58);ctx.fillStyle="#d9ffff";ctx.beginPath();ctx.arc(x,y,2.5,0,Math.PI*2);ctx.fill()}}ctx.restore()}
  loop(ts){const dt=Math.min(.033,(ts-this.lastTs)/1000||0);this.lastTs=ts;this.update(dt);this.draw();this.raf=requestAnimationFrame(this.loop)}
  updateUI(full=true){$("#score-label").textContent=this.score.toLocaleString();$("#combo-label").textContent="×"+this.combo;const sec=save.data.selectedMode==="rush"?Math.ceil(this.rushLeft):Math.floor(this.elapsed);$("#timer-label").textContent=Math.floor(sec/60)+":"+String(sec%60).padStart(2,"0");$("#timer-caption").textContent=save.data.selectedMode==="rush"?"Left":"Time";let lowest=0;for(let r=0;r<this.grid.length;r++)if((this.grid[r]||[]).some(Boolean))lowest=Math.max(lowest,this.cellPos(r,0).y);const pct=clamp((lowest-420)/(this.DANGER_Y-420),0,1);$("#board-label").textContent=pct>.8?"Danger":pct>.55?"Low":"Safe";$("#danger-hud").classList.toggle("danger",pct>.78);$("#current-preview").style.background=this.previewBackground(this.current);$("#next-preview").style.background=this.previewBackground(this.next);$("#swap-btn").disabled=this.swapUsed||!this.canAim();$("#guide-btn").textContent="GUIDE: "+(save.data.guide?"ON":"OFF");this.renderMisses();}
  previewBackground(color){const b=this.palette()[color%this.palette().length];return `radial-gradient(circle at 33% 27%,#fff 0 7%,${b} 22%,${b} 62%,#14222d 100%)`}
  renderMisses(){const box=$("#miss-pips");const max=this.diff().misses;if(box.children.length!==max){box.replaceChildren(...Array.from({length:max},()=>{const i=document.createElement("i");i.className="miss-pip";return i}))}[...box.children].forEach((el,i)=>el.classList.toggle("on",i<this.missesLeft))}
}

const game=new BubbleGame($("#game-canvas"));

function updateMenu(){
  const mode=MODES[save.data.selectedMode],d=DIFF[save.data.difficulty];$$("[data-mode]").forEach(b=>b.classList.toggle("active",b.dataset.mode===save.data.selectedMode));$("#difficulty-select").value=save.data.difficulty;$("#difficulty-note").textContent=d.note;$("#menu-mode-name").textContent=mode.name;$("#menu-mode-icon").textContent=mode.icon;$("#menu-mode-desc").textContent=mode.desc;$("#sound-label").textContent=save.data.sound?"On":"Off";$("#sound-icon").textContent=save.data.sound?"♪":"×";const run=save.data.activeRun;const compatible=run&&run.mode===save.data.selectedMode&&run.difficulty===save.data.difficulty;$("#continue-btn").classList.toggle("hidden",!compatible);$("#game-mode-name").textContent=mode.name;$("#game-subtitle").textContent=`${d.name.toUpperCase()} · ${d.colors} COLORS`;$("#mode-tip").textContent=save.data.selectedMode==="rush"?"The timer matters more than the ceiling. Keep chaining fast pops.":save.data.selectedMode==="endless"?"Clearing a wave immediately feeds the next one.":"Pop a cluster to keep the board high.";renderStats();renderThemes();updateCredits();
}

function bubblePreviewStyle(id){const colors=id==="candy"?CANDY_COLORS:id==="pearl"?PEARL_COLORS:BASE_COLORS;return `<div class="bubble-preview"><i style="background:${colors[0]}"></i><i style="background:${colors[1]}"></i><i style="background:${colors[2]}"></i></div>`}
let themeTab="bubbles";
function renderThemes(){const grid=$("#theme-grid");if(!grid)return;grid.innerHTML="";const isB=themeTab==="bubbles",data=isB?BUBBLE_SKINS:ARENAS,selected=isB?save.data.selectedBubble:save.data.selectedArena;for(const [id,item] of Object.entries(data)){const owned=save.owns(isB?"bubble":"arena",id),card=document.createElement("article");card.className="shop-card"+(selected===id?" selected":"");const art=isB?bubblePreviewStyle(id):`<div class="arena-preview" style="--ap-top:${item.top};--ap-bottom:${item.bottom};--ap-frame:${item.frame}"></div>`;card.innerHTML=`<div class="shop-art">${art}</div><h3>${item.name}</h3><p>${item.desc}</p><div class="shop-foot"><span class="${selected===id?"selected-tag":owned?"owned-tag":"price"}">${selected===id?"SELECTED":owned?"OWNED":"C "+item.price}</span><button class="shop-action">${selected===id?"ACTIVE":owned?"SELECT":"BUY"}</button></div>`;card.querySelector("button").disabled=selected===id;card.querySelector("button").onclick=()=>{const kind=isB?"bubble":"arena";if(!owned){if(!save.buy(kind,id,item.price)){toast("Not enough credits");return}}if(isB)save.data.selectedBubble=id;else save.data.selectedArena=id;save.persist();audio.tone(520,.08,"triangle",.03,120);renderThemes();game.updateUI();};grid.append(card)}}
function renderStats(){const s=save.data.stats,winRate=s.games?Math.round(s.wins/s.games*100):0;const items=[["Rounds",s.games],["Classic wins",s.wins],["Win rate",winRate+"%"],["Best score",s.bestScore.toLocaleString()],["Best combo","×"+s.bestCombo],["Bubbles popped",s.bubblesPopped.toLocaleString()],["Bubbles dropped",s.bubblesDropped.toLocaleString()],["Rush best",s.rushBest.toLocaleString()],["Endless best",s.endlessBest.toLocaleString()],["Credits earned","C "+s.creditsEarned.toLocaleString()]];const g=$("#stats-grid");if(g)g.innerHTML=items.map(([a,b])=>`<div class="panel stat-card"><span>${a}</span><strong>${b}</strong></div>`).join("")}

$("#hero-play").onclick=()=>$("#play-btn").click();
$$("[data-mode]").forEach(b=>b.onclick=()=>{save.data.selectedMode=b.dataset.mode;save.persist();updateMenu()});
$("#difficulty-select").onchange=e=>{save.data.difficulty=e.target.value;save.persist();updateMenu()};
$("#play-btn").onclick=()=>{if(save.data.activeRun)openModal($("#confirm-modal"));else game.newGame()};
$("#continue-btn").onclick=()=>{const r=save.data.activeRun;if(r&&r.mode===save.data.selectedMode&&r.difficulty===save.data.difficulty)game.restore(r);else{save.data.activeRun=null;save.persist();game.newGame()}};
$$("[data-open]").forEach(b=>b.onclick=()=>{renderStats();renderThemes();showScreen(b.dataset.open)});$$("[data-back]").forEach(b=>b.onclick=()=>{updateMenu();showScreen("menu-screen")});
$("#mode-info").onclick=()=>toast(MODES[save.data.selectedMode].desc);
$("#sound-btn").onclick=()=>{save.data.sound=!save.data.sound;save.persist();if(save.data.sound)audio.tone(520,.08,"triangle",.03,100);updateMenu()};
$$("[data-tab]").forEach(b=>b.onclick=()=>{themeTab=b.dataset.tab;$$("[data-tab]").forEach(x=>x.classList.toggle("active",x===b));renderThemes()});
$("#swap-btn").onclick=()=>game.swap();$("#guide-btn").onclick=()=>{save.data.guide=!save.data.guide;save.persist();game.updateUI()};
$("#pause-btn").onclick=()=>game.pause();$("#pause-side-btn").onclick=()=>game.pause();$("#resume-btn").onclick=()=>game.resume();$("#pause-menu").onclick=()=>{closeModal($("#pause-modal"));game.paused=true;game.persistRun();game.running=false;updateMenu();showScreen("menu-screen")};
$("#game-menu-btn").onclick=()=>game.pause();$("#new-btn").onclick=()=>openModal($("#confirm-modal"));$("#confirm-no").onclick=()=>closeModal($("#confirm-modal"));$("#confirm-yes").onclick=()=>{closeModal($("#confirm-modal"));save.data.activeRun=null;save.persist();game.newGame()};
$("#result-menu").onclick=()=>{closeModal($("#result-modal"));updateMenu();showScreen("menu-screen")};$("#result-again").onclick=()=>{closeModal($("#result-modal"));game.newGame()};
$$(".modal-layer").forEach(m=>m.addEventListener("pointerdown",e=>{if(e.target===m&&m.id!=="result-modal")closeModal(m)}));
window.addEventListener("beforeunload",()=>game.persistRun());
updateMenu();game.updateUI();
</script>
